# Copy this file to ".env" and fill in your values. Never commit .env to GitHub.

# PayPal sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Email of your sandbox PERSONAL account (acts as your foreign client)
SANDBOX_CLIENT_EMAIL=

# Your LLM key (we'll use this from Step 5 onwards)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Today's USD -> INR rate (used to convert income to rupees)
USD_INR=94.05

# Optional, after deploying: PayPal webhook ID (developer.paypal.com -> your app -> Webhooks)
PAYPAL_WEBHOOK_ID=

# Your kind of work: "profession" (software/IT, engineering, consulting, design of interiors...: 50% presumptive)
# or "business" (e.g. content writing, digital products: 6% of digital receipts). Ask a CA if unsure.
FREELANCER_TYPE=profession
